{% extends 'base.html.twig' %}

{% macro sort_link(label, column, sort, direction, search, filter, status, assignee, limit) %}
    {% set next_direction = (sort == column and direction == 'asc') ? 'desc' : 'asc' %}
    <a href="{{ path('app_asset_group_index', {'sort': column, 'direction': next_direction, 'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'page': 1}) }}"
       class="text-reset text-decoration-none fw-bold d-flex align-items-center gap-1">
        {{ label }}
        {% if sort == column %}
            {% if direction == 'asc' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 15l6 -6l6 6"/></svg>
            {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 9l6 6l6 -6"/></svg>
            {% endif %}
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon text-muted"><path d="M6 9l6 -6l6 6"/><path d="M6 15l6 6l6 -6"/></svg>
        {% endif %}
    </a>
{% endmacro %}


{% block title %}{{ 'asset_group.title'|trans }} - OdinShield{% endblock %}

{% block container_class %}container-fluid{% endblock %}

{% block page_header %}
<div class="page-header d-print-none">
    <div class="{{ block('container_class') }}">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h1 class="page-title">{{ 'asset_group.title'|trans }}</h1>
            </div>
            <div class="col-auto ms-auto">
                {% if is_granted('ASSET_GROUP_CREATE') %}
                <a id="new-asset-group-link" href="{{ path('app_asset_group_new', {'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon">
                        <path d="M12 5l0 14"/>
                        <path d="M5 12l14 0"/>
                    </svg>
                    {{ 'asset_group.new'|trans }}
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}
<div data-controller="remote-modal"
     data-remote-modal-loading-text-value="{{ 'common.loading'|trans }}"
     data-remote-modal-error-text-value="{{ 'common.load_error'|trans }}">

{% include '_include/_remote_modal.html.twig' with {
    modal_id: 'assetGroupDetailModal',
    primary_label: 'common.edit'
} %}

<div class="card">
    <div class="card-header">
        <form method="get" action="{{ path('app_asset_group_index') }}" class="d-flex flex-wrap gap-2 w-100 justify-content-between"
              data-turbo-frame="asset-group-table"
              data-controller="index-filter"
              data-index-filter-table-id-value="asset-group-table"
              data-index-filter-new-link-id-value="new-asset-group-link">
            <select name="limit" class="form-select w-auto" aria-label="{{ 'common.per_page_label'|trans }}" data-action="change->index-filter#submitForm">
                {% for option in [10, 25, 50, 75, 100] %}
                    <option value="{{ option }}" {% if option == limit %}selected{% endif %}>
                        {{ option }} {{ 'common.per_page'|trans }}
                    </option>
                {% endfor %}
            </select>
            <div class="d-flex flex-wrap gap-2">
            <div class="input-group input-group-flat" style="width: 280px;">
                <input type="text" name="search" id="search-input" value="{{ search }}" class="form-control" aria-label="{{ 'common.search_label'|trans }}"
                       placeholder="{{ 'common.search_placeholder'|trans }}"
                       data-index-filter-target="searchInput"
                       data-action="input->index-filter#toggleClear">
                <span class="input-group-text gap-1">
                    <button type="button" id="search-clear" aria-label="{{ 'common.clear_search'|trans }}"
                            class="btn btn-sm btn-ghost-secondary p-0 border-0 {% if not search %}d-none{% endif %}"
                            data-index-filter-target="searchClear"
                            data-action="click->index-filter#clearSearch">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M18 6l-12 12"/>
                            <path d="M6 6l12 12"/>
                        </svg>
                    </button>
                    <button type="submit" class="btn btn-sm btn-ghost-secondary p-0 border-0" aria-label="{{ 'common.search_label'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
                            <path d="M21 21l-6 -6"/>
                        </svg>
                    </button>
                </span>
            </div>
            <input type="hidden" id="filter-input" name="filter" value="{{ filter }}">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon me-1">
                        <path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 -2v-5l-4.414 -4.414a2 2 0 0 1 -.586 -1.414v-2.172z"/>
                    </svg>
                    <span id="filter-label">{{ filter_asset_type ? filter_asset_type.name : 'asset_group.filter.all_asset_types'|trans }}</span>
                </button>
                <div class="dropdown-menu">
                    <a href="{{ path('app_asset_group_index', {'filter': 'all', 'status': status, 'assignee': assignee, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                       class="dropdown-item {% if filter == 'all' %}active{% endif %}"
                       data-turbo-frame="asset-group-table"
                       data-filter-value="all"
                       data-action="index-filter#selectFilter"
                       data-index-filter-input-id-param="filter-input"
                       data-index-filter-label-id-param="filter-label"
                       data-index-filter-filter-value-param="all">
                        {{ 'asset_group.filter.all_asset_types'|trans }}
                    </a>
                    {% for at in all_asset_types %}
                        <a href="{{ path('app_asset_group_index', {'filter': at.uuid, 'status': status, 'assignee': assignee, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                           class="dropdown-item {% if (at.uuid ~ '') == filter %}active{% endif %}"
                           data-turbo-frame="asset-group-table"
                           data-filter-value="{{ at.uuid }}"
                           data-action="index-filter#selectFilter"
                           data-index-filter-input-id-param="filter-input"
                           data-index-filter-label-id-param="filter-label"
                           data-index-filter-filter-value-param="{{ at.uuid }}">
                            {{ at.name }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <input type="hidden" id="status-input" name="status" value="{{ status }}">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon me-1">
                        <path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 -2v-5l-4.414 -4.414a2 2 0 0 1 -.586 -1.414v-2.172z"/>
                    </svg>
                    <span id="status-label">{{ ('common.filter.' ~ status)|trans }}</span>
                </button>
                <div class="dropdown-menu">
                    {% for value in ['all', 'active', 'inactive'] %}
                        <a href="{{ path('app_asset_group_index', {'status': value, 'filter': filter, 'assignee': assignee, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                           class="dropdown-item {% if status == value %}active{% endif %}"
                           data-turbo-frame="asset-group-table"
                           data-status-value="{{ value }}"
                           data-action="index-filter#selectFilter"
                           data-index-filter-input-id-param="status-input"
                           data-index-filter-label-id-param="status-label"
                           data-index-filter-filter-value-param="{{ value }}">
                            {{ ('common.filter.' ~ value)|trans }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <input type="hidden" id="assignee-input" name="assignee" value="{{ assignee }}">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon me-1" aria-hidden="true">
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/>
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                    <span id="assignee-label">{{ ('common.filter.assignee_' ~ assignee)|trans }}</span>
                </button>
                <div class="dropdown-menu">
                    {% for value in ['all', 'unassigned'] %}
                        <a href="{{ path('app_asset_group_index', {'assignee': value, 'status': status, 'filter': filter, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                           class="dropdown-item {% if assignee == value %}active{% endif %}"
                           data-turbo-frame="asset-group-table"
                           data-assignee-value="{{ value }}"
                           data-action="index-filter#selectFilter"
                           data-index-filter-input-id-param="assignee-input"
                           data-index-filter-label-id-param="assignee-label"
                           data-index-filter-filter-value-param="{{ value }}">
                            {{ ('common.filter.assignee_' ~ value)|trans }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            </div>
        </form>
    </div>
    <turbo-frame id="asset-group-table" data-turbo-action="advance">
    <div class="card-table">
        {% if asset_groups|length > 0 %}
        <table class="table table-vcenter table-striped table-hover">
            <thead>
                <tr>
                    <th>{{ _self.sort_link('asset_group.field.name'|trans, 'name', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('asset_group.field.asset_type'|trans, 'assetType', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ _self.sort_link('asset_group.field.criticality'|trans, 'criticality', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-lg-table-cell">{{ _self.sort_link('asset_group.field.exposure'|trans, 'exposure', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-lg-table-cell">{{ _self.sort_link('asset_group.field.data_sensitivity'|trans, 'dataSensitivity', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ 'asset_group.field.software_count'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ _self.sort_link('asset_group.field.active'|trans, 'active', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for asset_group in asset_groups %}
                <tr>
                    <td>{{ asset_group.name }}</td>
                    <td>{{ asset_group.assetType.name }}</td>
                    {# #65 (Q6): the three classification axes are the basis of every effective-risk
                       score in this application, and until now they were visible only on the detail
                       page — so nobody could tell from the list how far the inventory is classified
                       at all, or spot an obviously wrong rating. #}
                    <td class="d-none d-md-table-cell">
                        <span class="badge bg-{{ asset_group.criticality.color() }}-lt">{{ ('asset_criticality.' ~ asset_group.criticality.value)|trans }}</span>
                    </td>
                    <td class="d-none d-lg-table-cell">
                        <span class="badge bg-{{ asset_group.exposure.color() }}-lt">{{ ('asset_exposure.' ~ asset_group.exposure.value)|trans }}</span>
                    </td>
                    <td class="d-none d-lg-table-cell">
                        <span class="badge bg-{{ asset_group.dataSensitivity.color() }}-lt">{{ ('data_sensitivity.' ~ asset_group.dataSensitivity.value)|trans }}</span>
                    </td>
                    <td class="d-none d-md-table-cell">
                        {% set sw_count = asset_group.software|length %}
                        <span class="badge bg-blue-lt">{{ sw_count }}</span>
                    </td>
                    <td class="d-none d-md-table-cell">
                        {% if asset_group.active %}
                            <span class="badge bg-success-lt">{{ 'common.yes'|trans }}</span>
                        {% else %}
                            <span class="badge bg-secondary-lt">{{ 'common.badge.inactive'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-ghost-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                    aria-label="{{ 'common.actions_for'|trans({'%name%': asset_group.name}) }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon">
                                    <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                </svg>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-sm">
                                <a href="{{ path('app_asset_group_show', {'uuid': asset_group.uuid, 'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item"
                                   data-action="remote-modal#open"
                                   data-remote-modal-url-param="{{ path('app_asset_group_modal', {'uuid': asset_group.uuid}) }}"
                                   {% if is_granted('ASSET_GROUP_MODIFY', asset_group) %}
                                   data-remote-modal-primary-url-param="{{ path('app_asset_group_edit', {'uuid': asset_group.uuid, 'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   {% endif %}
                                   data-remote-modal-title-param="{{ asset_group.name }}">
                                    {{ 'common.show'|trans }}
                                </a>
                                {% if is_granted('ASSET_GROUP_MODIFY', asset_group) %}
                                <a href="{{ path('app_asset_group_edit', {'uuid': asset_group.uuid, 'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item" data-turbo-frame="_top">
                                    {{ 'common.edit'|trans }}
                                </a>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th>{{ _self.sort_link('asset_group.field.name'|trans, 'name', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('asset_group.field.asset_type'|trans, 'assetType', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ _self.sort_link('asset_group.field.criticality'|trans, 'criticality', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-lg-table-cell">{{ _self.sort_link('asset_group.field.exposure'|trans, 'exposure', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-lg-table-cell">{{ _self.sort_link('asset_group.field.data_sensitivity'|trans, 'dataSensitivity', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ 'asset_group.field.software_count'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ _self.sort_link('asset_group.field.active'|trans, 'active', sort, direction, search, filter, status, assignee, limit) }}</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
        {% else %}
        <div class="text-center text-secondary py-4">
            {% if search == '' and filter == 'all' and status == 'all' and assignee == 'unassigned' %}
                {{ 'common.filter.none_unassigned'|trans }}
                <a href="{{ path('app_asset_group_index') }}" class="d-block mt-2 small">{{ 'common.reset_filters'|trans }}</a>
            {% elseif search != '' or filter != 'all' or status != 'all' or assignee != 'all' %}
                {{ 'asset_group.no_records_filtered'|trans }}
                <a href="{{ path('app_asset_group_index') }}" class="d-block mt-2 small">{{ 'common.reset_filters'|trans }}</a>
            {% else %}
                {{ 'asset_group.no_records'|trans }}
            {% endif %}
        </div>
        {% endif %}
    </div>
    {% include '_include/_pagination.html.twig' with {
        route: 'app_asset_group_index',
        query_params: {'search': search, 'filter': filter, 'status': status, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction},
    } %}
    </turbo-frame>
</div>

</div>
{% endblock %}
