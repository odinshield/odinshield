{% extends 'base.html.twig' %}

{% macro sort_link(label, column, sort, direction, search, filter, assignee, limit) %}
    {% set next_direction = (sort == column and direction == 'asc') ? 'desc' : 'asc' %}
    <a href="{{ path('app_software_index', {'sort': column, 'direction': next_direction, 'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'page': 1}) }}"
       class="text-reset text-decoration-none fw-bold d-flex align-items-center gap-1">
        {{ label }}
        {% if sort == column %}
            {% if direction == 'asc' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 15l6 -6l6 6"/></svg>
            {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 9l6 6l6 -6"/></svg>
            {% endif %}
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon text-muted"><path d="M6 9l6 -6l6 6"/><path d="M6 15l6 6l6 -6"/></svg>
        {% endif %}
    </a>
{% endmacro %}


{% block title %}{{ 'software.title'|trans }} - OdinShield{% endblock %}

{% block container_class %}container-fluid{% endblock %}

{% block page_header %}
<div class="page-header d-print-none">
    <div class="{{ block('container_class') }}">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h1 class="page-title">{{ 'software.title'|trans }}</h1>
            </div>
            <div class="col-auto ms-auto">
                {% if is_granted('SOFTWARE_CREATE') %}
                <a id="new-software-link" href="{{ path('app_software_new', {'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon">
                        <path d="M12 5l0 14"/>
                        <path d="M5 12l14 0"/>
                    </svg>
                    {{ 'software.new'|trans }}
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}
<div data-controller="remote-modal"
     data-remote-modal-loading-text-value="{{ 'common.loading'|trans }}"
     data-remote-modal-error-text-value="{{ 'common.load_error'|trans }}">

{% include '_include/_remote_modal.html.twig' with {
    modal_id: 'softwareDetailModal',
    primary_label: 'common.edit'
} %}

<div class="card">
    <div class="card-header">
        <form method="get" action="{{ path('app_software_index') }}" class="d-flex flex-wrap gap-2 w-100 justify-content-between"
              data-turbo-frame="software-table"
              data-controller="index-filter"
              data-index-filter-table-id-value="software-table"
              data-index-filter-new-link-id-value="new-software-link">
            <select name="limit" class="form-select w-auto" aria-label="{{ 'common.per_page_label'|trans }}" data-action="change->index-filter#submitForm">
                {% for option in [10, 25, 50, 75, 100] %}
                    <option value="{{ option }}" {% if option == limit %}selected{% endif %}>
                        {{ option }} {{ 'common.per_page'|trans }}
                    </option>
                {% endfor %}
            </select>
            <div class="d-flex flex-wrap gap-2">
            <div class="input-group input-group-flat" style="width: 280px;">
                <input type="text" name="search" id="search-input" value="{{ search }}" class="form-control" aria-label="{{ 'common.search_label'|trans }}"
                       placeholder="{{ 'common.search_placeholder'|trans }}"
                       data-index-filter-target="searchInput"
                       data-action="input->index-filter#toggleClear">
                <span class="input-group-text gap-1">
                    <button type="button" id="search-clear" aria-label="{{ 'common.clear_search'|trans }}"
                            class="btn btn-sm btn-ghost-secondary p-0 border-0 {% if not search %}d-none{% endif %}"
                            data-index-filter-target="searchClear"
                            data-action="click->index-filter#clearSearch">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M18 6l-12 12"/>
                            <path d="M6 6l12 12"/>
                        </svg>
                    </button>
                    <button type="submit" class="btn btn-sm btn-ghost-secondary p-0 border-0" aria-label="{{ 'common.search_label'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
                            <path d="M21 21l-6 -6"/>
                        </svg>
                    </button>
                </span>
            </div>
            <input type="hidden" id="filter-input" name="filter" value="{{ filter }}">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon me-1">
                        <path d="M4 4h16v2.172a2 2 0 0 1 -.586 1.414l-4.414 4.414v7l-6 -2v-5l-4.414 -4.414a2 2 0 0 1 -.586 -1.414v-2.172z"/>
                    </svg>
                    <span id="filter-label">{{ ('common.filter.' ~ filter)|trans }}</span>
                </button>
                <div class="dropdown-menu">
                    {% for value in ['all', 'active', 'inactive'] %}
                        <a href="{{ path('app_software_index', {'filter': value, 'assignee': assignee, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                           class="dropdown-item {% if filter == value %}active{% endif %}"
                           data-turbo-frame="software-table"
                           data-filter-value="{{ value }}"
                           data-action="index-filter#selectFilter"
                           data-index-filter-input-id-param="filter-input"
                           data-index-filter-label-id-param="filter-label"
                           data-index-filter-filter-value-param="{{ value }}">
                            {{ ('common.filter.' ~ value)|trans }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <input type="hidden" id="assignee-input" name="assignee" value="{{ assignee }}">
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon me-1" aria-hidden="true">
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/>
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                    <span id="assignee-label">{{ ('common.filter.assignee_' ~ assignee)|trans }}</span>
                </button>
                <div class="dropdown-menu">
                    {% for value in ['all', 'unassigned'] %}
                        <a href="{{ path('app_software_index', {'assignee': value, 'filter': filter, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': 1}) }}"
                           class="dropdown-item {% if assignee == value %}active{% endif %}"
                           data-turbo-frame="software-table"
                           data-assignee-value="{{ value }}"
                           data-action="index-filter#selectFilter"
                           data-index-filter-input-id-param="assignee-input"
                           data-index-filter-label-id-param="assignee-label"
                           data-index-filter-filter-value-param="{{ value }}">
                            {{ ('common.filter.assignee_' ~ value)|trans }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            </div>
        </form>
    </div>
    <turbo-frame id="software-table" data-turbo-action="advance">
    <div class="card-table">
        {% if software|length > 0 %}
        <table class="table table-vcenter table-striped table-hover">
            <thead>
                <tr>
                    <th>{{ _self.sort_link('software.field.name'|trans, 'name', sort, direction, search, filter, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('software.field.vendor'|trans, 'vendor', sort, direction, search, filter, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('software.field.version'|trans, 'version', sort, direction, search, filter, assignee, limit) }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.maintenance_source'|trans }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.eol_date'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'vulnerability.title'|trans }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.last_reviewed_at'|trans }}</th>
                    <th class="d-none d-lg-table-cell">{{ 'software.field.responsible_user'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for sw in software %}
                <tr>
                    <td>
                        {{ sw.name }}
                        {% if without_asset_group[sw.id] is defined %}
                            {# #319: the CSAF import matches this product but skips every hit — no asset group to attach it to. #}
                            {% set _no_asset_group = 'software.import_without_asset_group'|trans %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="icon ms-1 text-warning"
                                 role="img"
                                 aria-label="{{ _no_asset_group }}"
                                 title="{{ _no_asset_group }}">
                                <path d="M12 9v4"/>
                                <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/>
                                <path d="M12 16h.01"/>
                            </svg>
                        {% endif %}
                        {% if not sw.active %}<span class="badge bg-secondary-lt ms-1">{{ 'common.badge.inactive'|trans }}</span>{% endif %}
                        {% if sw.eolDate and sw.eolDate < date() %}<span class="badge bg-red-lt ms-1">{{ 'software.badge.eol'|trans }}</span>{% endif %}
                    </td>
                    <td class="text-secondary">{{ sw.vendor.name }}</td>
                    <td>
                        <span class="badge bg-blue-lt">{{ sw.version }}</span>
                        {% if sw.comparableVersion is null and sw.maintenanceSource.value == 'import' %}
                            {% set _not_comparable = 'software.version_not_comparable'|trans %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="icon ms-1 text-warning"
                                 role="img"
                                 aria-label="{{ _not_comparable }}"
                                 title="{{ _not_comparable }}">
                                <path d="M12 9v4"/>
                                <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/>
                                <path d="M12 16h.01"/>
                            </svg>
                        {% endif %}
                        {% if sw.predecessor %}
                            {% set _predecessor_label = ('software.successor.predecessor_label'|trans) ~ ': ' ~ sw.predecessor.name ~ ' ' ~ sw.predecessor.version %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                 stroke-linejoin="round" class="icon ms-1 text-secondary"
                                 role="img"
                                 aria-label="{{ _predecessor_label }}"
                                 title="{{ _predecessor_label }}">
                                <path d="M9 6l6 6l-6 6"/>
                            </svg>
                        {% endif %}
                    </td>
                    <td class="d-none d-xl-table-cell">
                        <span class="badge bg-{{ sw.maintenanceSource.color() }}-lt">{{ ('maintenance_source.' ~ sw.maintenanceSource.value)|trans }}</span>
                    </td>
                    <td class="d-none d-xl-table-cell text-secondary">
                        {% if sw.eolDate %}
                            {% set _is_past = sw.eolDate < date() %}
                            <span class="badge bg-{{ _is_past ? 'danger' : 'warning' }}-lt">
                                {{ sw.eolDate|format_datetime(dateFormat='short', timeFormat='none') }}
                            </span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="d-none d-md-table-cell">
                        {% set _stats = vuln_stats[sw.id] ?? {'openVulnCount': 0, 'worstSeverity': null} %}
                        {% if _stats.openVulnCount > 0 %}
                            <span class="badge bg-secondary-lt"
                                  aria-label="{{ _stats.openVulnCount ~ ' ' ~ 'vulnerability.title'|trans }}"
                                  title="{{ _stats.worstSeverity ? ('vulnerability_severity.' ~ _stats.worstSeverity.value)|trans }}">
                                {{ _stats.openVulnCount }}
                            </span>
                        {% else %}
                            <span class="badge bg-secondary-lt" aria-label="{{ '0 ' ~ 'vulnerability.title'|trans }}">0</span>
                        {% endif %}
                    </td>
                    <td class="d-none d-xl-table-cell text-secondary">
                        {% if sw.lastReviewedAt %}
                            {{ sw.lastReviewedAt|format_datetime(dateFormat='short', timeFormat='none') }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="d-none d-lg-table-cell">
                        {% if sw.responsibleUser %}
                            <span class="text-secondary">{{ sw.responsibleUser.fullName }}</span>
                        {% else %}
                            {# #66: an unowned product is the finding, not a blank — say so instead of showing a
                               dash. Deliberately NOT a coloured badge: measured in the browser, `bg-yellow-lt`
                               renders the label at 1.98:1 against the row in the light theme (`bg-warning` 2.27,
                               `text-warning` 2.13) — unreadable, and the same token family as #124. Plain
                               secondary text measures 4.83:1 light / 5.78:1 dark. The emphasis comes from the
                               dashboard hint and the filter, not from colour. #}
                            <span class="text-secondary fst-italic">{{ 'common.filter.assignee_unassigned'|trans }}</span>
                        {% endif %}
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-ghost-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                    aria-label="{{ 'common.actions_for'|trans({'%name%': sw.name}) }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon">
                                    <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                </svg>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-sm">
                                <a href="{{ path('app_software_show', {'uuid': sw.uuid, 'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item"
                                   data-action="remote-modal#open"
                                   data-remote-modal-url-param="{{ path('app_software_modal', {'uuid': sw.uuid}) }}"
                                   {% if is_granted('SOFTWARE_MODIFY', sw) %}
                                   data-remote-modal-primary-url-param="{{ path('app_software_edit', {'uuid': sw.uuid, 'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   {% endif %}
                                   data-remote-modal-title-param="{{ sw.name }} {{ sw.version }}">
                                    {{ 'common.show'|trans }}
                                </a>
                                {% if is_granted('SOFTWARE_MODIFY', sw) %}
                                <a href="{{ path('app_software_edit', {'uuid': sw.uuid, 'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item" data-turbo-frame="_top">
                                    {{ 'common.edit'|trans }}
                                </a>
                                {% endif %}
                                {% if is_granted('SOFTWARE_MODIFY', sw) or is_granted('SOFTWARE_SUCCESSOR', sw) %}
                                <div class="dropdown-divider"></div>
                                {% if is_granted('SOFTWARE_MODIFY', sw) %}
                                <a href="{{ path('app_vulnerability_new', {'software': sw.uuid}) }}"
                                   class="dropdown-item" data-turbo-frame="_top">
                                    {{ 'software.action.add_vulnerability'|trans }}
                                </a>
                                {% endif %}
                                {% if is_granted('SOFTWARE_SUCCESSOR', sw) %}
                                <a href="{{ path('app_software_successor_new', {'uuid': sw.uuid, 'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item" data-turbo-frame="_top">
                                    {{ 'software.successor.action'|trans }}
                                </a>
                                {% endif %}
                                {% endif %}
                                {# #216: only Manual software has a review cycle; the list keeps its filters afterwards #}
                                {% if is_granted('SOFTWARE_MODIFY', sw) and sw.maintenanceSource == enum('App\\Enum\\MaintenanceSource').Manual %}
                                <div class="dropdown-divider"></div>
                                <form method="post" action="{{ path('app_software_mark_reviewed', {'uuid': sw.uuid}) }}" data-turbo="false">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark-reviewed' ~ sw.uuid) }}">
                                    {% for name, value in {'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page} %}
                                    <input type="hidden" name="{{ name }}" value="{{ value }}">
                                    {% endfor %}
                                    <button type="submit" class="dropdown-item">
                                        {{ 'software.action.mark_reviewed'|trans }}
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th>{{ _self.sort_link('software.field.name'|trans, 'name', sort, direction, search, filter, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('software.field.vendor'|trans, 'vendor', sort, direction, search, filter, assignee, limit) }}</th>
                    <th>{{ _self.sort_link('software.field.version'|trans, 'version', sort, direction, search, filter, assignee, limit) }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.maintenance_source'|trans }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.eol_date'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'vulnerability.title'|trans }}</th>
                    <th class="d-none d-xl-table-cell">{{ 'software.field.last_reviewed_at'|trans }}</th>
                    <th class="d-none d-lg-table-cell">{{ 'software.field.responsible_user'|trans }}</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
        {% else %}
        <div class="text-center text-secondary py-4">
            {% if search == '' and filter == 'all' and assignee == 'unassigned' %}
                {{ 'common.filter.none_unassigned'|trans }}
                <a href="{{ path('app_software_index') }}" class="d-block mt-2 small">{{ 'common.reset_filters'|trans }}</a>
            {% elseif search != '' or filter != 'all' or assignee != 'all' %}
                {{ 'software.no_records_filtered'|trans }}
                <a href="{{ path('app_software_index') }}" class="d-block mt-2 small">{{ 'common.reset_filters'|trans }}</a>
            {% else %}
                {{ 'software.no_records'|trans }}
            {% endif %}
        </div>
        {% endif %}
    </div>
    {% include '_include/_pagination.html.twig' with {
        route: 'app_software_index',
        query_params: {'search': search, 'filter': filter, 'assignee': assignee, 'limit': limit, 'sort': sort, 'direction': direction},
    } %}
    </turbo-frame>
</div>

</div>
{% endblock %}
