<form method="post" action="{{ path('app_user_group_delete', {'uuid': user_group.uuid}) }}" data-turbo="false">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user_group.uuid) }}">
    <button type="button" class="btn btn-danger w-100"
            data-action="confirm-modal#open"
            data-confirm-modal-message-param="{{ 'user_group.confirm_delete'|trans }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" class="icon">
            <path d="M4 7l16 0"/>
            <path d="M10 11l0 6"/>
            <path d="M14 11l0 6"/>
            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12"/>
            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3"/>
        </svg>
        {{ 'user_group.delete'|trans }}
    </button>
</form>
