{% extends 'base.html.twig' %}

{% macro sort_link(label, column, sort, direction, search, limit) %}
    {% set next_direction = (sort == column and direction == 'asc') ? 'desc' : 'asc' %}
    <a href="{{ path('app_user_group_index', {'sort': column, 'direction': next_direction, 'search': search, 'limit': limit, 'page': 1}) }}"
       class="text-reset text-decoration-none fw-bold d-flex align-items-center gap-1">
        {{ label }}
        {% if sort == column %}
            {% if direction == 'asc' %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 15l6 -6l6 6"/></svg>
            {% else %}
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M6 9l6 6l6 -6"/></svg>
            {% endif %}
        {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon text-muted"><path d="M6 9l6 -6l6 6"/><path d="M6 15l6 6l6 -6"/></svg>
        {% endif %}
    </a>
{% endmacro %}


{% block title %}{{ 'user_group.title'|trans }} - OdinShield{% endblock %}

{% block container_class %}container-fluid{% endblock %}

{% block page_header %}
<div class="page-header d-print-none">
    <div class="{{ block('container_class') }}">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h1 class="page-title">{{ 'user_group.title'|trans }}</h1>
            </div>
            <div class="col-auto ms-auto">
                <a id="new-user-group-link" href="{{ path('app_user_group_new', {'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon">
                        <path d="M12 5l0 14"/>
                        <path d="M5 12l14 0"/>
                    </svg>
                    {{ 'user_group.new'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}
<div data-controller="remote-modal confirm-modal"
     data-remote-modal-loading-text-value="{{ 'common.loading'|trans }}"
     data-remote-modal-error-text-value="{{ 'common.load_error'|trans }}">

{% include '_include/_remote_modal.html.twig' with {
    modal_id: 'userGroupDetailModal',
    primary_label: 'common.edit'
} %}

{% include '_include/_confirm_modal.html.twig' with {
    modal_id: 'userGroupConfirmModal'
} %}

<div class="card">
    <div class="card-header">
        <form method="get" action="{{ path('app_user_group_index') }}" class="d-flex flex-wrap gap-2 w-100 justify-content-between"
              data-turbo-frame="user-group-table"
              data-controller="index-filter"
              data-index-filter-table-id-value="user-group-table"
              data-index-filter-new-link-id-value="new-user-group-link">
            <select name="limit" class="form-select w-auto" aria-label="{{ 'common.per_page_label'|trans }}" data-action="change->index-filter#submitForm">
                {% for option in [10, 25, 50, 75, 100] %}
                    <option value="{{ option }}" {% if option == limit %}selected{% endif %}>
                        {{ option }} {{ 'common.per_page'|trans }}
                    </option>
                {% endfor %}
            </select>
            <div class="input-group input-group-flat" style="width: 280px;">
                <input type="text" name="search" id="search-input" value="{{ search }}" class="form-control" aria-label="{{ 'common.search_label'|trans }}"
                       placeholder="{{ 'common.search_placeholder'|trans }}"
                       data-index-filter-target="searchInput"
                       data-action="input->index-filter#toggleClear">
                <span class="input-group-text gap-1">
                    <button type="button" id="search-clear" aria-label="{{ 'common.clear_search'|trans }}"
                            class="btn btn-sm btn-ghost-secondary p-0 border-0 {% if not search %}d-none{% endif %}"
                            data-index-filter-target="searchClear"
                            data-action="click->index-filter#clearSearch">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M18 6l-12 12"/>
                            <path d="M6 6l12 12"/>
                        </svg>
                    </button>
                    <button type="submit" class="btn btn-sm btn-ghost-secondary p-0 border-0" aria-label="{{ 'common.search_label'|trans }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                             stroke-linejoin="round" class="icon">
                            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"/>
                            <path d="M21 21l-6 -6"/>
                        </svg>
                    </button>
                </span>
            </div>
        </form>
    </div>
    <turbo-frame id="user-group-table" data-turbo-action="advance">
    <div class="card-table">
        {% if user_groups|length > 0 %}
        <table class="table table-vcenter table-striped table-hover">
            <thead>
                <tr>
                    <th>{{ _self.sort_link('user_group.field.name'|trans, 'name', sort, direction, search, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ 'user_group.field.user_count'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'user_group.field.asset_type_count'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            {% for user_group in user_groups %}
                <tr>
                    <td>{{ user_group.name }}</td>
                    <td class="d-none d-md-table-cell">
                        <span class="badge bg-blue-lt">{{ user_group.users|length }}</span>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <span class="badge bg-blue-lt">{{ user_group.assetTypes|length }}</span>
                    </td>
                    <td class="text-end">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-ghost-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                    aria-label="{{ 'common.actions_for'|trans({'%name%': user_group.name}) }}">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon">
                                    <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 5m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                    <path d="M12 19m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
                                </svg>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-sm">
                                <a href="{{ path('app_user_group_show', {'uuid': user_group.uuid, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item"
                                   data-action="remote-modal#open"
                                   data-remote-modal-url-param="{{ path('app_user_group_modal', {'uuid': user_group.uuid}) }}"
                                   data-remote-modal-primary-url-param="{{ path('app_user_group_edit', {'uuid': user_group.uuid, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   data-remote-modal-title-param="{{ user_group.name }}">
                                    {{ 'common.show'|trans }}
                                </a>
                                <a href="{{ path('app_user_group_edit', {'uuid': user_group.uuid, 'search': search, 'limit': limit, 'sort': sort, 'direction': direction, 'page': page}) }}"
                                   class="dropdown-item" data-turbo-frame="_top">
                                    {{ 'common.edit'|trans }}
                                </a>
                                <div class="dropdown-divider"></div>
                                <form method="post" action="{{ path('app_user_group_delete', {'uuid': user_group.uuid}) }}"
                                      data-turbo="false">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user_group.uuid) }}">
                                    <input type="hidden" name="search" value="{{ search }}">
                                    <input type="hidden" name="limit" value="{{ limit }}">
                                    <input type="hidden" name="sort" value="{{ sort }}">
                                    <input type="hidden" name="direction" value="{{ direction }}">
                                    <input type="hidden" name="page" value="{{ page }}">
                                    <button type="button" class="dropdown-item text-danger"
                                            data-action="confirm-modal#open"
                                            data-confirm-modal-message-param="{{ 'user_group.confirm_delete'|trans }}">
                                        {{ 'user_group.delete'|trans }}
                                    </button>
                                </form>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th>{{ _self.sort_link('user_group.field.name'|trans, 'name', sort, direction, search, limit) }}</th>
                    <th class="d-none d-md-table-cell">{{ 'user_group.field.user_count'|trans }}</th>
                    <th class="d-none d-md-table-cell">{{ 'user_group.field.asset_type_count'|trans }}</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
        {% else %}
        <div class="text-center text-secondary py-4">
            {% if search != '' %}
                {{ 'user_group.no_records_filtered'|trans }}
                <a href="{{ path('app_user_group_index') }}" class="d-block mt-2 small">{{ 'common.reset_filters'|trans }}</a>
            {% else %}
                {{ 'user_group.no_records'|trans }}
            {% endif %}
        </div>
        {% endif %}
    </div>
    {% include '_include/_pagination.html.twig' with {
        route: 'app_user_group_index',
        query_params: {'search': search, 'limit': limit, 'sort': sort, 'direction': direction},
    } %}
    </turbo-frame>
</div>

</div>
{% endblock %}
