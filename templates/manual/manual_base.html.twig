<!DOCTYPE html>
{# SEC-M08: _theme always passes through the ['light','dark'] allowlist or comes from a DB enum — safe in HTML attribute #}
{% set _theme_cookie = app.request.cookies.get('theme') %}
{% set _theme = _theme_cookie in ['light', 'dark'] ? _theme_cookie : (app.user and app.user.theme ? app.user.theme.value : null) %}
<html lang="{{ app.request.locale }}"{% if _theme %} data-bs-theme="{{ _theme }}"{% endif %}>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}{{ 'title'|trans({}, 'manual') }} – OdinShield{% endblock %}</title>
        <link rel="icon" href="{{ asset('img/odinshield.ico') }}" type="image/x-icon">
        {% if not _theme %}
            {# L21: first visit without a theme cookie/user preference — honour the OS
               prefers-color-scheme so the manual matches a dark app instead of flashing light.
               Runs in <head> before paint to avoid a FOUC. #}
            <script>
                if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                    document.documentElement.setAttribute('data-bs-theme', 'dark');
                }
            </script>
        {% endif %}
        {{ importmap('app') }}
        <link rel="stylesheet" href="{{ asset('styles/manual.css') }}">
    </head>
    <body data-controller="manual-nav manual-search manual-code-block manual-callout"
          data-manual-search-loading-text-value="{{ 'search.loading'|trans({}, 'manual') }}"
          data-manual-search-no-results-text-value="{{ 'search.no_results'|trans({}, 'manual') }}"
          data-manual-search-unavailable-text-value="{{ 'search.unavailable'|trans({}, 'manual') }}"
          data-manual-search-unavailable-hint-value="{{ 'search.unavailable_hint'|trans({}, 'manual') }}"
          data-manual-search-result-one-text-value="{{ 'search.result_one'|trans({}, 'manual') }}"
          {# %count% is filled in by manual-search in the browser; passed through unchanged here. #}
          data-manual-search-result-many-text-value="{{ 'search.result_many'|trans({'%count%': '%count%'}, 'manual') }}"
          data-manual-search-shortcut-value="{{ 'search.shortcut'|trans({}, 'manual') }}"
          data-manual-search-shortcut-mac-value="{{ 'search.shortcut_mac'|trans({}, 'manual') }}"
          data-manual-code-block-copy-label-value="{{ 'code.copy'|trans({}, 'manual') }}"
          data-manual-code-block-copied-label-value="{{ 'code.copied'|trans({}, 'manual') }}"
          data-manual-code-block-failed-label-value="{{ 'code.copy_failed'|trans({}, 'manual') }}">
        <a href="#manual-main" class="visually-hidden-focusable">{{ 'common.skip_to_content'|trans }}</a>
        <div class="manual-layout">

            {# ===== Top App Bar ===== #}
            <header class="manual-app-bar" role="banner">
                <button class="md-icon-button manual-menu-toggle"
                        type="button"
                        data-action="manual-nav#toggle"
                        data-manual-nav-target="toggle"
                        aria-controls="manual-drawer"
                        aria-expanded="false"
                        aria-label="{{ 'navigation.toggle'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16"/>
                    </svg>
                </button>
                <p class="manual-app-bar-title">
                    <a href="{{ path('app_manual_page', {slug: 'erste-schritte'}) }}">{{ 'title'|trans({}, 'manual') }}</a>
                </p>
                <div class="manual-app-bar-actions">
                    {# #207 (UX-44): manual-search appends the shortcut of the viewer's OS to the title. #}
                    <button class="md-icon-button"
                            type="button"
                            data-action="manual-search#open"
                            data-manual-search-target="opener"
                            title="{{ 'search.open'|trans({}, 'manual') }}"
                            aria-label="{{ 'search.open'|trans({}, 'manual') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="7"/>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                    </button>
                    <a class="md-icon-button" href="{{ path('app_manual_page', {slug: 'erste-schritte'}) }}" aria-label="{{ 'home.label'|trans({}, 'manual') }}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21V9h6v12"/>
                            <path d="M3 10l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        </svg>
                    </a>
                </div>
            </header>

            {# ===== Drawer (Sidebar) ===== #}
            <aside class="manual-drawer" id="manual-drawer" data-manual-nav-target="drawer" aria-label="{{ 'title'|trans({}, 'manual') }}">
                <div class="manual-drawer-header">
                    <div class="manual-drawer-pretitle">{{ 'title'|trans({}, 'manual') }}</div>
                    <a href="{{ path('app_manual_page', {slug: 'erste-schritte'}) }}" class="manual-drawer-brand">
                        <img src="{{ asset('img/odinshield.webp') }}" alt="">
                        OdinShield
                    </a>
                </div>

                <nav aria-label="{{ 'title'|trans({}, 'manual') }}">
                    {# #207 (UX-44): reading order, the same as previous/next in page.html.twig. #}
                    <ul class="manual-nav">
                        <li class="manual-nav-item">
                            <a class="manual-nav-link {{ current_slug == 'erste-schritte' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'erste-schritte'}) }}">{{ 'nav.first_steps'|trans({}, 'manual') }}</a>
                        </li>
                        <li class="manual-nav-item">
                            <a class="manual-nav-link {{ current_slug == 'schwachstellen' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'schwachstellen'}) }}">{{ 'nav.vulnerabilities'|trans({}, 'manual') }}</a>
                        </li>
                        <li class="manual-nav-item">
                            <a class="manual-nav-link {{ current_slug == 'inventar' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'inventar'}) }}">{{ 'nav.inventory'|trans({}, 'manual') }}</a>
                        </li>
                        <li class="manual-nav-item">
                            <a class="manual-nav-link {{ current_slug == 'einstellungen' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'einstellungen'}) }}">{{ 'nav.settings'|trans({}, 'manual') }}</a>
                        </li>

                        <li class="manual-nav-section">
                            <p class="manual-nav-caption">{{ 'nav.reference'|trans({}, 'manual') }}</p>
                            <ul class="manual-nav">
                                <li class="manual-nav-item">
                                    <a class="manual-nav-link {{ current_slug == 'team' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'team'}) }}">{{ 'nav.team'|trans({}, 'manual') }}</a>
                                </li>
                                <li class="manual-nav-item">
                                    <a class="manual-nav-link {{ current_slug == 'faq' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'faq'}) }}">{{ 'nav.faq'|trans({}, 'manual') }}</a>
                                </li>
                                <li class="manual-nav-item">
                                    <a class="manual-nav-link {{ current_slug == 'glossar' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'glossar'}) }}">{{ 'nav.glossary'|trans({}, 'manual') }}</a>
                                </li>
                                <li class="manual-nav-item">
                                    <a class="manual-nav-link {{ current_slug == 'tipps' ? 'active' }}" href="{{ path('app_manual_page', {slug: 'tipps'}) }}">{{ 'nav.tips'|trans({}, 'manual') }}</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>

                <div class="manual-drawer-footer">
                    <a href="{{ path('app_dashboard') }}" class="manual-back-link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12l14 0"/>
                            <path d="M5 12l6 6"/>
                            <path d="M5 12l6 -6"/>
                        </svg>
                        {{ 'back_to_app'|trans({}, 'manual') }}
                    </a>
                    <div class="manual-version">
                        <span class="manual-version-primary">{{ 'title'|trans({}, 'manual') }} v{{ manual_version }}</span>
                        <span class="manual-version-app">OdinShield v{{ app_version }}</span>
                    </div>
                </div>
            </aside>

            {# Mobile-Drawer-Scrim #}
            <div class="manual-drawer-scrim" data-manual-nav-target="scrim" data-action="click->manual-nav#close" aria-hidden="true"></div>

            {# ===== Content Wrapper ===== #}
            <div class="manual-content-wrap">
                <nav class="manual-breadcrumb-bar" aria-label="{{ 'breadcrumb.label'|trans({}, 'manual') }}">
                    <ol class="manual-breadcrumb">
                        <li class="manual-breadcrumb-item">
                            <a href="{{ path('app_manual_page', {slug: 'erste-schritte'}) }}">{{ 'title'|trans({}, 'manual') }}</a>
                        </li>
                        {% block breadcrumb %}{% endblock %}
                    </ol>
                </nav>

                <div class="manual-content-grid" data-controller="manual-toc">
                    <main class="manual-content-inner" id="manual-main">
                        <div class="manual-body" data-manual-toc-target="body">
                            {% block body %}{% endblock %}
                        </div>
                    </main>
                    <aside class="manual-toc" aria-label="{{ 'toc.label'|trans({}, 'manual') }}" data-manual-toc-target="toc">
                        <p class="manual-toc-title">{{ 'toc.label'|trans({}, 'manual') }}</p>
                        <ul class="manual-toc-list" data-manual-toc-target="list"></ul>
                    </aside>
                </div>

                {% block pagination %}{% endblock %}

                <footer class="manual-footer">
                    &copy; {{ 'now'|date('Y') }} OdinShield &mdash; AGPL-3.0-or-later
                </footer>
            </div>
        </div>

        {# ===== Search Modal ===== #}
        <div class="manual-search-modal" data-action="click->manual-search#scrimClick keydown.esc@window->manual-search#close" data-manual-search-target="modal" role="dialog" aria-modal="true" aria-labelledby="manual-search-title">
            <div class="manual-search-dialog" data-manual-search-target="dialog">
                <div class="manual-search-input-wrap">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    <label for="manual-search-input" class="visually-hidden" id="manual-search-title">{{ 'search.title'|trans({}, 'manual') }}</label>
                    <input id="manual-search-input"
                           type="search"
                           class="manual-search-input"
                           placeholder="{{ 'search.placeholder'|trans({}, 'manual') }}"
                           autocomplete="off"
                           data-manual-search-target="input"
                           data-action="input->manual-search#search">
                    <button class="md-icon-button" type="button" data-action="manual-search#close" aria-label="{{ 'search.close'|trans({}, 'manual') }}" style="color: var(--md-on-surface-medium);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="18" y1="6" x2="6" y2="18"/>
                            <line x1="6" y1="6" x2="18" y2="18"/>
                        </svg>
                    </button>
                </div>
                <div class="manual-search-results" data-manual-search-target="results"></div>
                {# #207 (UX-44): the result count is announced here, not the whole result list. #}
                <div class="visually-hidden" role="status" aria-live="polite" data-manual-search-target="status"></div>
            </div>
        </div>

        {# #207 (UX-44): copy feedback of the code blocks, announced; stays in the DOM so a change is read. #}
        <div class="visually-hidden" role="status" aria-live="polite" id="manual-copy-status"></div>
    </body>
</html>
