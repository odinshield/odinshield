{% extends 'base.html.twig' %}

{% block title %}{{ 'legal.title'|trans }} - OdinShield{% endblock %}

{% block page_header %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col">
                <h1 class="page-title">{{ 'legal.title'|trans }}</h1>
                <div class="text-secondary mt-1">{{ 'legal.subtitle'|trans }}</div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

