    {# SBOM — only for those who may download it. A link that ends in a 403 for most users is
       a defect, not a feature (#83); the gate here mirrors SEC-019 on the route itself. #}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ISB') %}
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">{{ 'legal.sbom.title'|trans }}</h3>
                {# No bg-*-lt badge: measured 4.36:1 light and 2.69:1 dark, both below WCAG AA —
                   the family #124 is about. text-secondary carries both themes. #}
                <div class="card-options">
                    <span class="text-secondary small">CycloneDX 1.6</span>
                </div>
            </div>
            <div class="card-body">
                <p class="text-secondary">{{ 'legal.sbom.description'|trans }}</p>
                {# #217: a file download, not a page — Turbo would fetch it as a visit (same as
                   the audit CSV export). Without a built SBOM a hint replaces the link. #}
                {% if sbom_available %}
                <a href="{{ path('app_sbom') }}" class="btn btn-primary" data-turbo="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon" aria-hidden="true">
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2"/>
                        <path d="M7 11l5 5l5 -5"/>
                        <path d="M12 4l0 12"/>
                    </svg>
                    {{ 'legal.sbom.download'|trans }}
                </a>
                {% else %}
                <p class="mb-0 d-flex gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon flex-shrink-0" aria-hidden="true">
                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/>
                        <path d="M12 9h.01"/>
                        <path d="M11 12h1v4h1"/>
                    </svg>
                    <span>{{ 'legal.sbom.unavailable'|trans }}</span>
                </p>
                {% endif %}
            </div>
        </div>
    </div>
    {% endif %}

