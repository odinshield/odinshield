<div class="modal modal-blur fade" id="occurrenceStatusModal" tabindex="-1" role="dialog" aria-hidden="true"
     data-occurrence-status-modal-target="dialog">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-occurrence-status-modal-target="title"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="{{ 'common.close'|trans }}"></button>
            </div>
            <div class="modal-body" data-occurrence-status-modal-target="body"></div>
        </div>
    </div>
</div>
