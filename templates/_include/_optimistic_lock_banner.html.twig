{# Conflict banner shown when an optimistic lock conflict is detected on save.
   Variables:
   - last_editor:    string|null  — username of the user who saved the latest version (HasEditedBy.updatedBy)
   - last_edited_at: \DateTimeInterface|null — when the latest version was saved (HasTimestamps.updatedAt)
   - audit_url:      string|null  — optional link to the entity's audit timeline
#}
<div class="alert alert-warning alert-dismissible mb-3" role="alert">
    <div class="d-flex">
        <div>
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" class="icon alert-icon me-2">
                <path d="M12 9v4"/>
                <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/>
                <path d="M12 16h.01"/>
            </svg>
        </div>
        <div>
            <h2 class="alert-title h4">{{ 'common.optimistic_lock.banner_title'|trans }}</h2>
            <div class="text-secondary">{{ 'common.optimistic_lock.banner_body'|trans }}</div>
            {% if last_editor or last_edited_at %}
                <div class="text-secondary mt-1 small">
                    {{ 'common.optimistic_lock.last_edited_by'|trans({
                        '%user%': last_editor ?: '—',
                        '%when%': last_edited_at ? last_edited_at|format_datetime(dateFormat='short', timeFormat='short') : '—',
                    }) }}
                    {% if audit_url is defined and audit_url %}
                        &mdash; <a href="{{ audit_url }}" class="text-secondary">{{ 'common.optimistic_lock.view_history'|trans }}</a>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'common.close'|trans }}"></button>
</div>
