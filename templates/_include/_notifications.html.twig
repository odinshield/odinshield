{% set _new_count = app.user ? app_new_vulnerability_count() : 0 %}
<div class="nav-item dropdown me-3">
    <a
        href="#"
        class="nav-link px-0"
        data-bs-toggle="dropdown"
        aria-label="{{ 'navigation.notifications_count'|trans({'%count%': _new_count}) }}"
    >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
             stroke-linejoin="round" class="icon">
            <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6"/>
            <path d="M9 17v1a3 3 0 0 0 6 0v-1"/>
        </svg>
        {% if _new_count > 0 %}
            <span class="badge bg-red badge-notification badge-blink badge-empty"></span>
        {% endif %}
    </a>
    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow notifications-menu">
        {% if _new_count > 0 %}
        <a href="{{ path('app_vulnerability_index', {'assignee': 'me', 'status': 'open'}) }}"
           class="dropdown-item d-flex align-items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                 stroke-linejoin="round" class="icon text-secondary flex-shrink-0">
                <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3"/>
                <path d="M12 8l0 4"/>
                <path d="M12 16l.01 0"/>
            </svg>
            <span>{{ 'navigation.open_vulnerabilities_assigned'|trans }}</span>
            <span class="ms-auto badge bg-red-lt">{{ _new_count }}</span>
        </a>
        {% else %}
        <div class="dropdown-item-text text-secondary text-center py-3">
            {{ 'navigation.no_new_notifications'|trans }}
        </div>
        {% endif %}
    </div>
</div>
