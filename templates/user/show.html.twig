{% extends 'base.html.twig' %}

{% block title %}{{ user.firstName }} {{ user.lastName }} - OdinShield{% endblock %}

{% block page_header %}
<div class="page-header d-print-none">
    <div class="container-xl">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <a href="{{ path('app_user_index', return_params) }}" class="btn btn-ghost-secondary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                         stroke-linejoin="round" class="icon">
                        <path d="M15 6l-6 6l6 6"/>
                    </svg>
                    {{ 'user.back_to_list'|trans }}
                </a>
            </div>
            <div class="col">
                <h1 class="page-title">{{ user.firstName }} {{ user.lastName }}</h1>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block body %}
<div class="row row-cards">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                {{ include('user/_detail.html.twig') }}
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a href="{{ path('app_user_index', return_params) }}" class="btn btn-outline-secondary">
                    {{ 'user.back_to_list'|trans }}
                </a>
                <a href="{{ path('app_user_edit', {'uuid': user.uuid, 'return_to': 'show'}|merge(return_params ?? {})) }}" class="btn btn-primary">
                    {{ 'common.edit'|trans }}
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
