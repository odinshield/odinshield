{% from '_include/_form_macros.html.twig' import field_errors %}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ 'security.change_password.title'|trans }} - OdinShield</title>
        <link rel="icon" href="{{ asset('img/odinshield.ico') }}" type="image/x-icon">
        {{ importmap('app') }}
    </head>
    <body class="d-flex flex-column">
        <div class="page page-center">
            <div class="container container-tight py-4">

                <div class="text-center mb-4">
                    <a href="{{ path('app_dashboard') }}" class="navbar-brand navbar-brand-autodark">
                        <img src="{{ asset('img/odinshield.webp') }}" alt="OdinShield" class="rounded" style="height: 64px; width: auto;">
                    </a>
                </div>

                <div class="card card-md">
                    <div class="card-body">
                        <h1 class="h2 text-center mb-2">{{ 'security.change_password.heading'|trans }}</h1>
                        <p class="text-secondary text-center mb-4">{{ 'security.change_password.description'|trans }}</p>

                        {# L24: this standalone onboarding page renders no toasts — surface the
                           rate-limit (and any error) flash as an inline alert instead. #}
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger" role="alert">{{ message|trans }}</div>
                        {% endfor %}

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            <label class="form-label" for="{{ form.plainPassword.first.vars.id }}">
                                {{ form.plainPassword.first.vars.label|trans }}
                                <span class="text-danger ms-1">*</span>
                            </label>
                            <div class="input-group" data-controller="password-toggle"
                                 data-password-toggle-show-label-value="{{ 'security.login.show_password'|trans }}"
                                 data-password-toggle-hide-label-value="{{ 'security.login.hide_password'|trans }}">
                                {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control' ~ (not form.plainPassword.first.vars.valid ? ' is-invalid'), 'data-password-toggle-target': 'input'}}) }}
                                <span class="input-group-text">
                                    <button type="button" class="link-secondary p-0 border-0 bg-transparent lh-1"
                                            data-password-toggle-target="button"
                                            data-action="password-toggle#toggle"
                                            aria-label="{{ 'security.login.show_password'|trans }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="icon"
                                             data-password-toggle-target="iconShow">
                                            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/>
                                            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/>
                                        </svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="icon d-none"
                                             data-password-toggle-target="iconHide">
                                            <path d="M3 3l18 18"/>
                                            <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83"/>
                                            <path d="M9.363 5.365a9 9 0 0 1 2.637-.365c3.6 0 6.6 2 9 6c-.822 1.37 -1.728 2.519 -2.706 3.438"/>
                                            <path d="M6.354 6.36c-2.166 1.407 -4.04 3.597 -5.354 6.14c2.4 4 5.4 6 9 6c1.737 0 3.37-.502 4.846-1.399"/>
                                        </svg>
                                    </button>
                                </span>
                            </div>
                            {% if form.plainPassword.first.vars.help %}
                                <div class="alert alert-info alert-sm mt-2 py-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round" class="icon alert-icon me-1">
                                        <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/>
                                        <path d="M12 8v4"/>
                                        <path d="M12 16h.01"/>
                                    </svg>
                                    {{ form.plainPassword.first.vars.help|trans(form.plainPassword.first.vars.help_translation_parameters) }}
                                </div>
                            {% endif %}
                            {{ field_errors(form.plainPassword.first) }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="{{ form.plainPassword.second.vars.id }}">
                                {{ form.plainPassword.second.vars.label|trans }}
                                <span class="text-danger ms-1">*</span>
                            </label>
                            <div class="input-group" data-controller="password-toggle"
                                 data-password-toggle-show-label-value="{{ 'security.login.show_password'|trans }}"
                                 data-password-toggle-hide-label-value="{{ 'security.login.hide_password'|trans }}">
                                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control' ~ (not form.plainPassword.second.vars.valid ? ' is-invalid'), 'data-password-toggle-target': 'input'}}) }}
                                <span class="input-group-text">
                                    <button type="button" class="link-secondary p-0 border-0 bg-transparent lh-1"
                                            data-password-toggle-target="button"
                                            data-action="password-toggle#toggle"
                                            aria-label="{{ 'security.login.show_password'|trans }}">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="icon"
                                             data-password-toggle-target="iconShow">
                                            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/>
                                            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/>
                                        </svg>
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                             stroke-linejoin="round" class="icon d-none"
                                             data-password-toggle-target="iconHide">
                                            <path d="M3 3l18 18"/>
                                            <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83"/>
                                            <path d="M9.363 5.365a9 9 0 0 1 2.637-.365c3.6 0 6.6 2 9 6c-.822 1.37 -1.728 2.519 -2.706 3.438"/>
                                            <path d="M6.354 6.36c-2.166 1.407 -4.04 3.597 -5.354 6.14c2.4 4 5.4 6 9 6c1.737 0 3.37-.502 4.846-1.399"/>
                                        </svg>
                                    </button>
                                </span>
                            </div>
                            {{ field_errors(form.plainPassword.second) }}
                        </div>

                        {% if form.plainPassword.vars.errors|length > 0 %}
                            <div class="alert alert-danger alert-sm mt-2 py-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon alert-icon me-1">
                                    <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"/>
                                    <path d="M12 8v4"/>
                                    <path d="M12 16h.01"/>
                                </svg>
                                {% for error in form.plainPassword.vars.errors %}{{ error.message }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                            </div>
                        {% endif %}

                        <div class="form-footer">
                            <button type="submit" class="btn btn-primary w-100" data-controller="form-submit">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" class="icon">
                                    <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z"/>
                                    <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"/>
                                    <path d="M8 11v-4a4 4 0 1 1 8 0v4"/>
                                </svg>
                                {{ 'security.change_password.submit'|trans }}
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>

                <div class="text-center text-secondary mt-3">
                    &copy; {{ 'now'|date('Y') }} OdinShield &mdash; AGPL-3.0-or-later
                </div>

            </div>
        </div>
    </body>
</html>