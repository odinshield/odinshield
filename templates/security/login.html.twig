<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ 'security.login.title'|trans }} - OdinShield</title>
        <link rel="icon" href="{{ asset('img/odinshield.ico') }}" type="image/x-icon">
        {{ importmap('app') }}
    </head>
    <body class="d-flex flex-column">
        <div class="page page-center">
            <div class="container container-tight py-4">

                <div class="text-center mb-4">
                    <a href="{{ path('app_dashboard') }}" class="navbar-brand navbar-brand-autodark">
                        <img src="{{ asset('img/odinshield.webp') }}" alt="OdinShield" class="rounded" style="height: 64px; width: auto;">
                    </a>
                </div>

                <div class="card card-md">
                    <div class="card-body">
                        <h1 class="h2 text-center mb-4">{{ 'security.login.heading'|trans }}</h1>

                        {# #188: the login page is standalone (no toasts) — show the confirmation after a
                           forced password change inline. #}
                        {% for message in app.flashes('success') %}
                            {# text-body: Tabler's green text on the green tint measured 2.6:1 (light theme). #}
                            <div class="alert alert-success text-body" role="status">{{ message|trans }}</div>
                        {% endfor %}

                        {% if error %}
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <div class="d-flex">
                                <div>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round" class="icon alert-icon">
                                        <path d="M12 9v4"/>
                                        <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z"/>
                                        <path d="M12 16h.01"/>
                                    </svg>
                                </div>
                                <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            </div>
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="{{ 'common.close'|trans }}"></a>
                        </div>
                        {% endif %}

                        {% if app.user %}
                        <div class="alert alert-info">
                            {{ 'security.login.reauth_required'|trans({ '%user%': app.user.userIdentifier }) }}
                            <form method="post" action="{{ path('app_logout') }}" class="d-inline" data-turbo="false">
                                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('logout') }}">
                                <button type="submit" class="btn btn-link p-0 align-baseline">{{ 'navigation.logout'|trans }}</button>
                            </form>
                        </div>
                        {% endif %}

                        <form method="post" autocomplete="on">
                            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-3">
                                <label class="form-label" for="username">{{ 'security.login.username'|trans }}</label>
                                <input
                                    type="text"
                                    name="_username"
                                    id="username"
                                    class="form-control"
                                    value="{{ last_username ?: app.user.userIdentifier|default('') }}"
                                    autocomplete="username"
                                    {{ app.user ? '' : 'autofocus' }}
                                    required
                                    placeholder="{{ 'security.login.username_placeholder'|trans }}"
                                >
                            </div>

                            <div class="mb-2">
                                <label class="form-label" for="password">
                                    {{ 'security.login.password'|trans }}
                                </label>
                                <div class="input-group input-group-flat" data-controller="password-toggle"
                                     data-password-toggle-show-label-value="{{ 'security.login.show_password'|trans }}"
                                     data-password-toggle-hide-label-value="{{ 'security.login.hide_password'|trans }}">
                                    <input
                                        type="password"
                                        name="_password"
                                        id="password"
                                        class="form-control"
                                        autocomplete="current-password"
                                        {{ app.user ? 'autofocus' }}
                                        required
                                        placeholder="{{ 'security.login.password_placeholder'|trans }}"
                                        data-password-toggle-target="input"
                                    >
                                    <span class="input-group-text">
                                        <button type="button" class="link-secondary p-0 border-0 bg-transparent lh-1"
                                                data-password-toggle-target="button"
                                                data-action="password-toggle#toggle"
                                                aria-label="{{ 'security.login.show_password'|trans }}">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round" class="icon"
                                                 data-password-toggle-target="iconShow">
                                                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/>
                                                <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/>
                                            </svg>
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                                 stroke-linejoin="round" class="icon d-none"
                                                 data-password-toggle-target="iconHide">
                                                <path d="M3 3l18 18"/>
                                                <path d="M10.584 10.587a2 2 0 0 0 2.828 2.83"/>
                                                <path d="M9.363 5.365a9 9 0 0 1 2.637-.365c3.6 0 6.6 2 9 6c-.822 1.37 -1.728 2.519 -2.706 3.438"/>
                                                <path d="M6.354 6.36c-2.166 1.407 -4.04 3.597 -5.354 6.14c2.4 4 5.4 6 9 6c1.737 0 3.37-.502 4.846-1.399"/>
                                            </svg>
                                        </button>
                                    </span>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-check">
                                    <input type="checkbox" name="_remember_me" class="form-check-input">
                                    <span class="form-check-label">{{ 'security.login.remember_me'|trans }}</span>
                                </label>
                            </div>

                            <div class="form-footer">
                                <button type="submit" class="btn btn-primary w-100" data-controller="form-submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                         stroke-linejoin="round" class="icon">
                                        <path d="M9 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2"/>
                                        <path d="M3 12h13l-3 -3"/>
                                        <path d="M13 15l3 -3"/>
                                    </svg>
                                    {{ 'security.login.submit'|trans }}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="text-center text-secondary mt-3">
                    &copy; {{ 'now'|date('Y') }} OdinShield &mdash; AGPL-3.0-or-later
                </div>

            </div>
        </div>
    </body>
</html>
