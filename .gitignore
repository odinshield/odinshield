###> symfony/framework-bundle ###
/environment/.env.local
/environment/.env.local.php
/environment/.env.*.local
# SEC-003: Never commit backup env files — they may contain secrets.
/environment/*.bak
/config/secrets/prod/prod.decrypt.private.php
/public/bundles/
/var/
/vendor/
###< symfony/framework-bundle ###

###> phpunit/phpunit ###
/phpunit.xml
/.phpunit.cache/
###< phpunit/phpunit ###

###> symfony/asset-mapper ###
/public/assets/
/assets/vendor/
###< symfony/asset-mapper ###

###> friendsofphp/php-cs-fixer ###
/.php-cs-fixer.php
/.php-cs-fixer.cache
###< friendsofphp/php-cs-fixer ###

###> phpstan/phpstan ###
phpstan.neon
###< phpstan/phpstan ###

###> docker ###
/docker/db/data/
###< docker ###

# ── Root-level credential files (legacy docker/staging env files) ─────────────
# SEC-003: These files may contain real secrets and must never be committed.
/.env
/.env.*
# Exception: the deployment TEMPLATE carries no secrets (placeholders only) and is
# the documented starting point in README.md — it has to be in the repo, or a fresh
# clone cannot follow the deploy instructions. Keep it free of real values.
!/.env.deploy.example

# ── Database / application backup files ──────────────────────────────────────
# Backup files may contain sensitive data (credentials, PII) and must never
# be committed. Keep them out of the repo regardless of their location.
/*.bak
/*.sql
/*.dump
/.env.docker.stage

# ── Local TLS / CA certificates (generated by Caddy / mkcert for dev) ────────
# These are local CA artifacts that should not be committed — they are
# environment-specific and regenerated automatically on each dev setup.
/*.crt
/*.pem
/*.key

# ── Pagefind build artifacts (generated by `make manual-index`) ──────────────
/.pagefind-build/
/public/pagefind/

# ── Saved email files (error notifications, ad-hoc dumps) ────────────────────
# Mails saved to the repo root for analysis must never be committed —
# they contain headers, IP addresses, and may include stack traces with
# absolute paths. Includes Outlook custom-property sidecars (file:OECustomProperty).
*.eml
*.eml:OECustomProperty

# ── Claude Code harness runtime artifacts ───────────────────────────────────
# Transient local state only — the curated /.claude/agent-memory/ stays tracked.
/.claude/scheduled_tasks.lock
/.claude/settings.local.json

# ── SBOM (generated at build time, #82) ──────────────────────────────────────
# The image build produces its own; a local copy from `make sbom` is a working file.
/sbom.json

# ── Python bytecode ──────────────────────────────────────────────────────────
# The Makefile runs deploy/*.py with `python3 -B`; this catches any other run, which would
# otherwise leave the tree dirty for push-check and the ci stamp.
__pycache__/

# ── ci stamp ─────────────────────────────────────────────────────────────────
# Written by `make ci` in the claude container, read by make push/ship/build-release and the
# pre-push hook on the host (Makefile CI_STAMP).
/.ci-ok
