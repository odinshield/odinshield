# OdinShield — Production deployment environment template (Traefik edition)
#
# This TEMPLATE is version-controlled. Copy it to `.env`, fill in the values there,
# and keep that copy out of version control — it holds your secrets.
#
# Generate APP_SECRET:       openssl rand -hex 32
# Generate POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
#
# Required (compose fails fast if unset): ODINSHIELD_IMAGE_TAG, TRAEFIK_HOST,
# APP_SECRET, POSTGRES_PASSWORD, MONOLOG_ERROR_TO.

# ── Image ──────────────────────────────────────────────────────────────────────
# Pin to a specific release tag. REQUIRED — `latest` is not accepted to keep
# deploys reproducible (see SEC-010). Bump this for every upgrade.
#
# NOTE: image tags carry NO leading "v". The git tag is v2.0.1, the image is
# 2.0.1 — the Makefile tags from the VERSION file verbatim. Using "v…" here
# fails the pull with `manifest unknown`.
ODINSHIELD_IMAGE_TAG=2.0.1

# ── Traefik ────────────────────────────────────────────────────────────────────
# Hostname Traefik will route to this service and request a TLS cert for.
# Note: in setups where Traefik sits behind a first-line proxy / WAF / CDN, this is
# the INTERNAL hostname — see APP_PUBLIC_URL below for the externally-visible URL
# used by outgoing mail links.
TRAEFIK_HOST=odinshield.example.com

# Name of the external Docker network Traefik is attached to (default: traefik).
# Create once on the Docker host: docker network create traefik
# TRAEFIK_NETWORK=traefik

# Name that keys the Traefik router, service and middleware of this stack
# (default: odinshield). SET IT when more than one OdinShield instance runs on the
# same Traefik: these names are Traefik-GLOBAL, not per-stack. Two instances both
# calling their router "odinshield" collide and one of them silently disappears —
# no error anywhere, one host simply stops being routed.
# Allowed characters: lowercase letters, digits and hyphen. Anything else (dots,
# spaces, umlauts) is not a valid Traefik router name.
# INSTANCE_NAME=odinshield

# Traefik middlewares applied to the HTTPS router, as a comma-separated list of
# fully-qualified names (e.g. crowdsec-bouncer@docker,rate-limit@file).
# ONLY used by compose.frontproxy.yaml, where it is REQUIRED — compose fails fast
# if it is unset. The base compose.deploy.yaml ignores this variable.
# TRAEFIK_MIDDLEWARES=crowdsec-bouncer@docker

# Defence-in-depth Host header allowlist (Symfony's framework.trusted_hosts).
# `compose.deploy.yaml` derives this as `^(${TRAEFIK_HOST}|localhost)$` — enough when
# Traefik is the public face.
#
# YOU MUST SET IT when a first-line proxy sits in front of Traefik. The host Symfony
# checks is then NOT the one Traefik routes on: with a trusted proxy Symfony prefers
# X-Forwarded-Host, and a front proxy that rewrites Host to the internal name still
# puts the PUBLIC name there. TRAEFIK_HOST must stay the internal name (Traefik has to
# match what it actually receives) while the public name must be listed here — which
# the derived default cannot express, since it only ever yields one hostname.
# Symptoms of getting this wrong: HTTP 400 (host rejected by Symfony) or, if you
# "fix" it by pointing TRAEFIK_HOST at the public name, HTTP 404 (no Traefik router
# matches). Escape the dots — the derived default does not, so `example.com` there
# also matches `exampleXcom`.
# TRUSTED_HOSTS_REGEX=^(public\.example\.com|internal\.example\.net|localhost)$

# Proxies whose X-Forwarded-* headers Symfony believes. The default REMOTE_ADDR trusts
# only the directly-connecting Traefik — enough when Traefik is the public face.
#
# YOU MUST SET IT when a first-line proxy sits in front of Traefik (#199): otherwise
# every user appears with the front proxy's IP, and login throttling locks out all of
# them at once. List the Traefik network's subnet and the front proxy's address; how to
# read both is described at the top of compose.frontproxy.yaml.
# TRUSTED_PROXIES=172.22.0.0/16,10.20.0.2

# Traefik certificate resolver name as defined in your Traefik static config (default: letsencrypt).
# TRAEFIK_CERT_RESOLVER=letsencrypt

# ── Outbound Proxy ────────────────────────────────────────────────────────────────────
# Optional (#190): CIDR exceptions to the outbound private-network block, comma-separated,
# no spaces — e.g. an HTTP proxy on a private address: OUTBOUND_ALLOWED_SUBNETS=10.20.0.5/32
#OUTBOUND_ALLOWED_SUBNETS=

# ── Application ────────────────────────────────────────────────────────────────
# 64-character hex string used for CSRF tokens, cookies, and encryption.
# NEVER share or commit this value.
APP_SECRET=                                                                # run: openssl rand -hex 32

# Timezone for PHP and PostgreSQL (e.g. Europe/Berlin, UTC).
TZ=Europe/Berlin

# Optional: show an environment badge in the navbar (e.g. "STAGING").
# Leave unset/empty for production. APP_ENV stays "prod" regardless — this is purely
# a visual marker so users can tell which environment they're looking at.
# APP_ENV_LABEL=staging

# Externally-visible base URL of the running app (with scheme + host, no trailing slash).
# Used by Symfony's URL generator in CLI / worker / async contexts where there is no
# incoming HTTP request to derive the host from — most importantly the "Open
# vulnerability" CTA link in notification mails.
#
# Leave unset when Traefik IS the public face → falls back to https://${TRAEFIK_HOST}.
# Set when a first-line proxy / WAF / CDN sits in front and TRAEFIK_HOST is internal
# only (e.g. odinshield.internal.example.com), so mail links must point to the public
# hostname instead.
# APP_PUBLIC_URL=https://odinshield.example.com

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_DB=app
# Strong random password — required.
POSTGRES_PASSWORD=                                         # run: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
POSTGRES_VERSION=18.4
POSTGRES_CHARSET=utf8
# Monitoring of the Postgres image by What's Up Docker (WUD). Default false.
# true adds this instance's database container to WUD's watch list; the container
# is otherwise invisible there. Leave it false on all but ONE instance: the image
# is identical everywhere, so every watching instance reports the same update
# again. Takes effect on the next `docker compose up -d` (labels are set at
# container creation, a restart does not re-read them).
WUD_WATCH=false

# ── Mailer ─────────────────────────────────────────────────────────────────────
# Use null://null to disable email delivery entirely.
# SMTP example (with auth):    smtp://user:pass@mail.example.com:587?encryption=tls
# SMTP example (trusted net):  smtp://mail.example.com:587?encryption=tls
MAILER_DSN=null://null
# Display name and address used as the From: header on all outgoing emails.
MAILER_SENDER="OdinShield <noreply@example.com>"
# Recipient for prod error-report mails (monolog). REQUIRED — compose fails fast if
# unset, deliberately: the image ships a placeholder default (admin@odinshield.local),
# so an unset value would silently deliver every production error mail to a dead
# mailbox instead of erroring at boot. Single recipient only — the monolog handler
# wraps to_email in a list, which the csv: multi-recipient processor breaks.
MONOLOG_ERROR_TO=ops@example.com

# ── CSAF importer (optional) ───────────────────────────────────────────────────
# Recipient for CSAF provider-failure alerts (sent when a provider crosses the
# auto-pause threshold). Leave empty to suppress these mails entirely.
# CSAF_ADMIN_EMAIL=security@example.com

# Override the scheduler cron expression for the CSAF importer (UTC, standard
# 5-field syntax). Leave empty to use the parameter default in
# config/packages/csaf.yaml (currently '0 3,15 * * *' — twice daily at
# 03:00 + 15:00 UTC). After changing, restart php + worker so the Scheduler
# re-reads the schedule. Validate with `docker compose exec php bin/console
# debug:scheduler csaf` before restarting — an invalid expression crashes the
# worker on start-up.
# CSAF_SCHEDULE_CRON=0 6,18 * * *

# How often to re-notify while a CSAF provider stays automatically paused (issue
# #63). Unset = 7 days. The circuit breaker used to mail exactly once, at the
# moment it tripped, and then stay quiet for good — a provider that nobody acted
# on stayed dead. Deliberately NOT tied to the run interval: at two runs a day
# that would be two mails per broken provider per day. Set to a larger value on
# a stage where nobody wants the reminder.
# CSAF_PAUSE_REMINDER_DAYS=7

# ── Exploitation enricher: FIRST EPSS + CISA KEV (optional) ────────────────────
# EPSS and "actively exploited" come from their originals (FIRST.org, CISA) via a
# daily enrichment pass over every open vulnerability that carries a CVE.
#
# Recipient for enricher failure alerts (sent when the circuit breaker trips after
# consecutive failures). Leave empty to rely on the ISB/admin role holders only.
# EXPLOITATION_ADMIN_EMAIL=security@example.com

# Override the scheduler cron expression for the enricher (UTC, standard 5-field
# syntax). Leave empty to use the parameter default in
# config/packages/exploitation.yaml (currently '30 4 * * *' — once daily, after the
# morning CSAF run). Validate via `docker compose exec php bin/console
# debug:scheduler exploitation` before restarting — an invalid expression crashes
# the worker on start-up.
# EXPLOITATION_SCHEDULE_CRON=30 5 * * *

# Same as CSAF_PAUSE_REMINDER_DAYS, for the enricher. Unset = 7 days.
# EXPLOITATION_PAUSE_REMINDER_DAYS=7

# Where the CISA KEV catalogue is downloaded from. Unset = www.cisa.gov. CISA blocks
# that feed by origin: if `odinshield:exploitation:status` shows "Degraded" with
# "CISA KEV download failed: HTTP/2 403", check from the host with
#   curl -s -o /dev/null -w '%{http_code}\n' https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# and switch to CISA's own GitHub mirror (byte-identical, synced within minutes):
# EXPLOITATION_KEV_URL=https://raw.githubusercontent.com/cisagov/kev-data/develop/known_exploited_vulnerabilities.json

# ── Update check (optional) ────────────────────────────────────────────────────
# Once a day the worker reads a public version.json and, if a newer OdinShield
# release exists, shows a hint on the dashboard for ISB and administrators and
# mails the administrators once per release. The request is a plain GET without
# any instance data. Switch it off on installations without internet access:
# UPDATE_CHECK_ENABLED=0
#
# Source of the version information. Unset = the version.json in the public
# repository. Status and last error: `docker compose exec php bin/console
# odinshield:update:check --status`.
# UPDATE_CHECK_URL=https://raw.githubusercontent.com/odinshield/odinshield/main/version.json

# ── FrankenPHP tuning (optional) ───────────────────────────────────────────────
# Override the worker count (default: FrankenPHP auto-detects based on CPU count).
# FRANKENPHP_WORKER_CONFIG=num 8
# Recycle a worker after this many requests to cap memory growth.
# FRANKENPHP_LOOP_MAX=1000

# ── Access logs (CrowdSec ingestion) ──────────────────────────────────────────
# Host directory bind-mounted into the php container at /var/log/caddy.
# Prepare once on the host — FrankenPHP runs as **www-data, UID 33** in the prod image
# (verify with: docker run --rm --entrypoint sh <image> -c id):
#   sudo mkdir -p /var/log/odinshield
#   sudo chown 33:33 /var/log/odinshield
#   sudo chmod 750   /var/log/odinshield
# Then point CrowdSec at the same path (read-only) and install the
# `crowdsecurity/caddy` collection — see deployment docs.
#
# NOTE: once this is enabled, Caddy writes its access log to the FILE, not to stdout.
# An empty `docker compose logs php` then no longer proves that no requests arrived —
# read access.log instead. It logs `host` and `X-Forwarded-Host` side by side, which is
# the fastest way to tell a Symfony 400 from a Traefik 404.
# ODINSHIELD_LOG_DIR=/var/log/odinshield
#
# In front-proxy mode (compose.frontproxy.yaml) the file log is always on and the
# default path is ./data/log — inside the stack directory, so it stays collision-free
# when several instances share a host. Set ODINSHIELD_LOG_DIR to move it elsewhere.

# ── Running behind a reverse proxy that terminates TLS ────────────────────────
# Traefik then has no ACME certresolver, and the base file's certresolver label
# would make it retry ACME forever. Add the override file to EVERY compose call:
#
#   docker compose -f compose.deploy.yaml -f compose.frontproxy.yaml up -d
#
# It drops the certresolver and the HTTP→HTTPS redirect router (the front proxy
# answers port 80 itself), requires TRAEFIK_MIDDLEWARES, and switches the access
# log to a file. The front proxy must set the Host header to TRAEFIK_HOST — if it
# forwards the public name instead, Traefik answers 404 because no router matches.

# ── Clouds with a reduced path MTU ────────────────────────────────────────────
# Some clouds run their private network below the Ethernet default of 1500 — Hetzner
# Cloud, for example, uses 1450. Docker still creates its networks with 1500, and the
# mismatch is silent and selective: small responses pass, large ones hang (a TLS
# handshake with a multi-kilobyte certificate chain is enough), so an importer times
# out against one provider while everything else looks healthy.
#
# This belongs in the Docker daemon of the HOST, not in this compose file — it is a
# property of the environment, not of the application:
#
#   /etc/docker/daemon.json
#   { "default-network-opts": { "bridge": { "com.docker.network.driver.mtu": "1450" } } }
#   systemctl restart docker
#
# It only affects NEWLY created networks. Existing ones — including an external
# Traefik network — keep their MTU until they are removed and created again.

# ── Image beziehen ─────────────────────────────────────────────────────────────
# Dieses Repository veroeffentlicht (noch) kein fertiges Container-Image. Baue es
# selbst und tagge es passend zu ODINSHIELD_IMAGE_TAG:
#   docker build -t odinshield:<version> --target frankenphp_prod .
